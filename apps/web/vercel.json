{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/web/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://TROCAR-PELO-DOMINIO-DO-PROJETO-API.vercel.app/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
